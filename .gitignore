# Obsidian. Settings are worth carrying between machines; these are not.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# Sweep output. Regenerable from the scripts beside it, so not a source of
# truth — and large. The scripts and cluster config are versioned; the pulls
# are not.
contemplative/sweeps/raw.jsonl
contemplative/sweeps/urls_active.json
contemplative/sweeps/survivors.json
__pycache__/
contemplative/sweeps/api_*.jsonl
contemplative/sweeps/survivors_*.json
contemplative/sweeps/framed_*.json
contemplative/sweeps/lp_*.json
contemplative/sweeps/lp_urls.txt
contemplative/sweeps/report_data.json
contemplative/sweeps/*.log
